{
  "$comment": "Kim design tokens v1 — source of truth for Kim Manager and Subak GUIs. See docs/DESIGN_SYSTEM.md. Sizes are logical pixels (scaled by per-monitor DPI). Contrast requirements below are enforced by `cargo xtask design-check` (run by cargo test).",
  "tokens_version": 1,
  "themes": {
    "kim-dark": {
      "color": {
        "bg.base": "#0E0E12",
        "bg.raised": "#15151B",
        "bg.overlay": "#1C1B24",
        "bg.hover": "#22212C",
        "bg.selected": "#2A2838",
        "border.subtle": "#26252F",
        "border.strong": "#6A6680",
        "text.primary": "#E8E6F0",
        "text.secondary": "#A9A6B8",
        "text.muted": "#9592A8",
        "text.disabled": "#55536A",
        "text.on-accent": "#0E0E12",
        "accent": "#B7A6F5",
        "accent.hover": "#C7B9FA",
        "accent.pressed": "#9B86F0",
        "accent.soft": "#2B2742",
        "focus.ring": "#C9BCFF",
        "status.success": "#8BC79A",
        "status.warning": "#E8C27A",
        "status.danger": "#F0868F",
        "status.info": "#8AB4F8",
        "claude.idle": "#9592A8",
        "claude.in-progress": "#B7A6F5",
        "claude.need-input": "#E8C27A",
        "claude.error": "#F0868F",
        "claude.done": "#8BC79A",
        "claude.unknown": "#6A6680",
        "terminal.foreground": "#D8D6E0",
        "terminal.background": "#0E0E12",
        "terminal.cursor": "#B7A6F5",
        "terminal.selection": "#3A3460",
        "ansi.black": "#3A3848",
        "ansi.red": "#F0868F",
        "ansi.green": "#8BC79A",
        "ansi.yellow": "#E8C27A",
        "ansi.blue": "#8AB4F8",
        "ansi.magenta": "#C9A6F5",
        "ansi.cyan": "#7FD3D9",
        "ansi.white": "#D8D6E0",
        "ansi.bright-black": "#8E8AA3",
        "ansi.bright-red": "#FFA3AB",
        "ansi.bright-green": "#A8E0B6",
        "ansi.bright-yellow": "#F5D79C",
        "ansi.bright-blue": "#A9C8FF",
        "ansi.bright-magenta": "#DCC4FF",
        "ansi.bright-cyan": "#A2E6EA",
        "ansi.bright-white": "#F5F4FA"
      },
      "contrast": [
        { "fg": "text.primary", "bg": ["bg.base", "bg.raised", "bg.overlay", "bg.hover", "bg.selected"], "min": 7.0, "why": "body text, AAA" },
        { "fg": "text.secondary", "bg": ["bg.base", "bg.raised", "bg.overlay", "bg.hover", "bg.selected"], "min": 4.5, "why": "secondary text, AA" },
        { "fg": "text.muted", "bg": ["bg.base", "bg.raised", "bg.overlay", "bg.hover", "bg.selected"], "min": 4.5, "why": "captions and hints, AA" },
        { "fg": "text.on-accent", "bg": ["accent", "accent.hover", "accent.pressed"], "min": 4.5, "why": "primary button label" },
        { "fg": "accent", "bg": ["bg.base", "bg.raised", "bg.overlay", "accent.soft"], "min": 4.5, "why": "links and accent text" },
        { "fg": "focus.ring", "bg": ["bg.base", "bg.raised", "bg.overlay", "bg.selected"], "min": 3.0, "why": "focus indicator, WCAG 2.4.11/1.4.11" },
        { "fg": "border.strong", "bg": ["bg.base", "bg.raised", "bg.overlay"], "min": 3.0, "why": "input and control boundaries, WCAG 1.4.11" },
        { "fg": "status.success", "bg": ["bg.base", "bg.raised", "bg.overlay"], "min": 4.5, "why": "status text" },
        { "fg": "status.warning", "bg": ["bg.base", "bg.raised", "bg.overlay"], "min": 4.5, "why": "status text" },
        { "fg": "status.danger", "bg": ["bg.base", "bg.raised", "bg.overlay"], "min": 4.5, "why": "status text" },
        { "fg": "status.info", "bg": ["bg.base", "bg.raised", "bg.overlay"], "min": 4.5, "why": "status text" },
        { "fg": "claude.idle", "bg": ["bg.base", "bg.raised", "bg.selected"], "min": 3.0, "why": "indicator dot (non-text), always paired with text label" },
        { "fg": "claude.in-progress", "bg": ["bg.base", "bg.raised", "bg.selected"], "min": 3.0, "why": "indicator dot" },
        { "fg": "claude.need-input", "bg": ["bg.base", "bg.raised", "bg.selected"], "min": 3.0, "why": "indicator dot" },
        { "fg": "claude.error", "bg": ["bg.base", "bg.raised", "bg.selected"], "min": 3.0, "why": "indicator dot" },
        { "fg": "claude.done", "bg": ["bg.base", "bg.raised", "bg.selected"], "min": 3.0, "why": "indicator dot" },
        { "fg": "claude.unknown", "bg": ["bg.base", "bg.raised"], "min": 3.0, "why": "hollow ring indicator" },
        { "fg": "terminal.foreground", "bg": ["terminal.background", "terminal.selection"], "min": 7.0, "why": "terminal text" },
        { "fg": "ansi.bright-black", "bg": ["terminal.background"], "min": 4.5, "why": "comments and dim output stay readable" },
        { "fg": "ansi.red", "bg": ["terminal.background"], "min": 4.5, "why": "ANSI foreground" },
        { "fg": "ansi.green", "bg": ["terminal.background"], "min": 4.5, "why": "ANSI foreground" },
        { "fg": "ansi.yellow", "bg": ["terminal.background"], "min": 4.5, "why": "ANSI foreground" },
        { "fg": "ansi.blue", "bg": ["terminal.background"], "min": 4.5, "why": "ANSI foreground" },
        { "fg": "ansi.magenta", "bg": ["terminal.background"], "min": 4.5, "why": "ANSI foreground" },
        { "fg": "ansi.cyan", "bg": ["terminal.background"], "min": 4.5, "why": "ANSI foreground" },
        { "fg": "ansi.white", "bg": ["terminal.background"], "min": 4.5, "why": "ANSI foreground" },
        { "fg": "terminal.cursor", "bg": ["terminal.background"], "min": 3.0, "why": "cursor visibility" }
      ]
    }
  },
  "typography": {
    "ui.family": ["Segoe UI Variable Text", "Segoe UI", "Malgun Gothic", "Segoe UI Emoji", "Segoe UI Symbol"],
    "mono.family": ["Cascadia Mono", "Consolas", "D2Coding", "Malgun Gothic", "Segoe UI Emoji", "Segoe UI Symbol"],
    "size.caption": 11,
    "size.body": 12,
    "size.emphasis": 13,
    "size.title": 15,
    "size.terminal": 13,
    "weight.regular": 400,
    "weight.semibold": 600,
    "line-height.ui": 1.35,
    "line-height.terminal": 1.2
  },
  "space": { "0": 0, "1": 2, "2": 4, "3": 6, "4": 8, "5": 12, "6": 16, "7": 24, "8": 32 },
  "radius": { "s": 4, "m": 6, "l": 10, "pill": 999 },
  "size": {
    "tabbar.height": 32,
    "tab.min-width": 96,
    "tab.max-width": 220,
    "titlebar.caption-button.width": 46,
    "statusdot.diameter": 8,
    "floating-icon.size": 40,
    "progress.height": 4,
    "control.height": 28,
    "control.height.compact": 24,
    "pane.divider": 1,
    "pane.active-border": 1,
    "focus.ring.width": 2,
    "focus.ring.offset": 1,
    "hit-target.min": 24
  },
  "motion": {
    "duration.instant": 0,
    "duration.fast": 80,
    "duration.base": 120,
    "duration.slow": 160,
    "easing.standard": [0.2, 0.0, 0.0, 1.0],
    "pulse.period": 1600,
    "reduced-motion": "all durations become 0; the in-progress pulse becomes a static ring"
  },
  "elevation": {
    "overlay.shadow": "0 8 24 rgba(0,0,0,0.45)",
    "overlay.border": "border.subtle"
  }
}

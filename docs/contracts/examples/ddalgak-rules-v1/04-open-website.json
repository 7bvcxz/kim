        },
        {
          "id": "search-docs",
          "title": "Open the AutoHotkey v2 hotkey reference",
          "enabled": true,
          "trigger": {"keys": "Ctrl+Shift+F10"},
          "steps": [{"type": "open_url", "url": "https://www.autohotkey.com/docs/v2/Hotkeys.htm#Symbols"}],
          "consent": {"launch-programs": {"granted_at": "2026-11-04T09:41:00Z", "via": "gui", "fingerprint": "sha256:9135c38b8194c4f510fab7c8e3194db6a1eddfe4fc01b9040aafdb0460cb73f6"}}
        },
        {
          "id": "morning-tabs",
          "title": "Open two dashboards, one after the other",
          "enabled": true,
          "trigger": {"keys": "Ctrl+Shift+F11"},
          "steps": [

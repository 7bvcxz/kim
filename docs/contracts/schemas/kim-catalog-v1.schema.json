{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hellomouv/kim/docs/contracts/schemas/kim-catalog-v1.schema.json",
  "title": "Kim tool catalog, schema version 1",
  "description": "Shape of catalog.json (docs/CATALOG_FORMAT.md). Kim additionally enforces semantic rules (unique ids/versions/targets, SemVer, dependency targets, safe entrypoints, expiry after generation) and verifies the detached ed25519 signature.",
  "type": "object",
  "required": ["schema", "schema_version", "catalog_version", "generated_at", "expires_at", "publisher", "tools"],
  "properties": {
    "schema": { "const": "kim.catalog" },
    "schema_version": { "const": 1 },
    "catalog_version": { "type": "integer", "minimum": 1 },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "publisher": { "type": "string", "minLength": 1 },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } }
  },
  "$defs": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "tool_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "tool": {
      "type": "object",
      "required": ["id", "name", "summary", "description", "license", "support", "releases"],
      "properties": {
        "id": { "$ref": "#/$defs/tool_id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string" },
        "homepage": { "type": "string", "pattern": "^https://" },
        "license": { "type": "string", "minLength": 1 },
        "support": { "enum": ["stable", "preview", "in-development", "deprecated"] },
        "releases": { "type": "array", "items": { "$ref": "#/$defs/release" } }
      }
    },
    "release": {
      "type": "object",
      "required": ["version", "channel", "published_at", "release_notes", "assets"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "channel": { "enum": ["stable", "preview"] },
        "published_at": { "$ref": "#/$defs/timestamp" },
        "release_notes": { "type": "string" },
        "min_kim_version": { "$ref": "#/$defs/semver" },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "version_req"],
            "properties": {
              "tool": { "$ref": "#/$defs/tool_id" },
              "version_req": { "type": "string", "minLength": 1 }
            }
          }
        },
        "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } }
      }
    },
    "asset": {
      "type": "object",
      "required": ["os", "arch", "url", "size", "sha256", "kind", "entrypoint"],
      "properties": {
        "os": { "enum": ["windows", "linux"] },
        "arch": { "enum": ["x86_64", "aarch64"] },
        "min_os_build": { "type": "integer", "minimum": 0 },
        "url": { "type": "string", "pattern": "^(https://.+|http://(127\\.0\\.0\\.1|localhost|\\[::1\\])([:/].*)?)$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "kind": { "enum": ["zip", "exe"] },
        "entrypoint": { "type": "string", "minLength": 1 }
      }
    }
  }
}

{
  "schema": "ddalgak.rules",
  "schema_version": 1,
  "hotkey_contract": 1,
  "active_profile": "dev",
  "exported": {
    "by_version": "0.0.1",
    "exported_at": "2026-11-04T12:00:00Z",
    "withheld": [
      "env_values"
    ]
  },
  "profiles": [
    {
      "id": "dev",
      "title": "Development",
      "description": "Editor and terminal keys; shared with the team.",
      "default_mode": "base",
      "modes": [
        {
          "id": "base",
          "title": "Base"
        },
        {
          "id": "nav",
          "title": "Navigation",
          "icon": "N",
          "parent": "base"
        }
      ],
      "rules": [
        {
          "id": "dev-caps",
          "title": "CapsLock is Escape",
          "enabled": false,
          "trigger": {
            "keys": "CapsLock"
          },
          "steps": [
            {
              "type": "remap",
              "to": "Escape"
            }
          ]
        },
        {
          "id": "dev-nav",
          "title": "F14 holds Navigation",
          "enabled": false,
          "trigger": {
            "keys": "Ctrl+Alt+Shift+F14"
          },
          "steps": [
            {
              "type": "mode",
              "mode": "nav",
              "op": "hold"
            }
          ]
        },
        {
          "id": "dev-left",
          "title": "H is Left in Navigation",
          "enabled": false,
          "trigger": {
            "keys": "code:KeyH"
          },
          "modes": [
            "nav"
          ],
          "steps": [
            {
              "type": "remap",
              "to": "Left"
            }
          ]
        },
        {
          "id": "dev-sig",
          "title": "Typing ;sig signs a message",
          "enabled": false,
          "trigger": {
            "hotstring": {
              "abbreviation": ";sig",
              "immediate": true
            }
          },
          "steps": [
            {
              "type": "type_text",
              "text": "감사합니다.\n김민수 드림"
            }
          ]
        },
        {
          "id": "dev-editor",
          "title": "Ctrl+Alt+Shift+F6 opens the editor",
          "enabled": false,
          "trigger": {
            "keys": "Ctrl+Alt+Shift+F6"
          },
          "steps": [
            {
              "type": "open_program",
              "args": [
                "-multiInst"
              ],
              "env": [
                {
                  "name": "TOOL_MODE",
                  "value": ""
                },
                {
                  "name": "API_TOKEN",
                  "value": ""
                }
              ],
              "path": "%ProgramFiles%\\Notepad++\\notepad++.exe"
            }
          ]
        }
      ]
    },
    {
      "id": "gaming",
      "title": "Gaming",
      "default_mode": "base",
      "modes": [
        {
          "id": "base",
          "title": "Base"
        }
      ],
      "rules": [
        {
          "id": "game-insert",
          "title": "Insert is blocked",
          "enabled": false,
          "trigger": {
            "keys": "Insert"
          },
          "steps": [
            {
              "type": "block"
            }
          ]
        }
      ]
    }
  ]
}

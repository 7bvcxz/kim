{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hellomouv/kim/blob/main/docs/contracts/schemas/noeul-ipc-v1.schema.json",
  "title": "Noeul IPC v1 message",
  "description": "One JSON frame between the noeul CLI and the running Noeul instance (4-byte little-endian length, then the UTF-8 JSON object; at most 65536 bytes). See docs/adr/0023-noeul-app-foundation.md §4, docs/adr/0029-noeul-pin-engine.md (pin methods, Step 53), docs/adr/0044-noeul-pin-transforms-and-control.md (pin.set, groups, Step 54) and crates/noeul/src/ipc.rs. Errors carry registered CLI error codes (docs/CLI_CONTRACT.md §6). Pictures never cross the pipe; results carry IDs, geometry and counts only (NOEUL-SEC-008).",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/welcome" },
    { "$ref": "#/$defs/connection_error" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response_ok" },
    { "$ref": "#/$defs/response_err" }
  ],
  "$defs": {
    "u64": { "type": "integer", "minimum": 0 },
    "version_string": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "pin_id": { "type": "string", "pattern": "^pin-[1-9][0-9]*$" },
    "action_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
    "error_code": {
      "description": "Registered CLI error codes the instance may answer with.",
      "enum": [
        "io", "internal", "permission_denied", "usage", "protocol_error", "busy", "timeout",
        "unsupported_platform", "confirmation_required", "cancelled",
        "noeul_incompatible", "pin_not_found", "nothing_to_pin", "image_invalid",
        "desktop_unavailable", "clipboard_unavailable", "noeul_unresponsive",
        "hotkeys_invalid", "hotkeys_from_newer_version"
      ]
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/error_code" },
        "message": { "type": "string", "minLength": 1 },
        "hint": { "type": "string" },
        "details": { "type": "array", "items": { "type": "string" } }
      }
    },
    "point": {
      "description": "A point in device pixels of the virtual desktop.",
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
        "y": { "type": "integer", "minimum": -1000000, "maximum": 1000000 }
      }
    },
    "zoom": { "description": "Pin zoom in percent; 100 = one image pixel per device pixel (Step 53); any whole percent since border resizing (Step 54).", "type": "integer", "minimum": 10, "maximum": 800 },
    "opacity": { "description": "Pin opacity in percent; never below 10 (Step 54, NOEUL-FR-062).", "type": "integer", "minimum": 10, "maximum": 100 },
    "group_name": { "description": "A pin group (Step 54): 1–32 letters, digits, spaces, `-`, `_` or `.`, starting with a letter or digit.", "type": "string", "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N} ._-]{0,31}$" },
    "orientation": {
      "description": "How a pin is turned (Step 54): mirrored left-right first, then rotated clockwise.",
      "type": "object",
      "required": ["rotation", "mirrored"],
      "additionalProperties": false,
      "properties": {
        "rotation": { "enum": [0, 90, 180, 270] },
        "mirrored": { "type": "boolean" }
      }
    },
    "rect": {
      "description": "Device pixels of the virtual desktop.",
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
        "y": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
        "width": { "type": "integer", "minimum": 1, "maximum": 32767 },
        "height": { "type": "integer", "minimum": 1, "maximum": 32767 }
      }
    },
    "hello": {
      "type": "object",
      "required": ["type", "protocol", "client"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "hello" },
        "protocol": {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        },
        "client": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 64 },
            "version": { "$ref": "#/$defs/version_string" },
            "pid": { "$ref": "#/$defs/u64" }
          }
        }
      }
    },
    "welcome": {
      "type": "object",
      "required": ["type", "protocol", "instance"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "welcome" },
        "protocol": { "type": "integer", "minimum": 1 },
        "instance": {
          "type": "object",
          "required": ["pid", "version", "started_at"],
          "additionalProperties": false,
          "properties": {
            "pid": { "$ref": "#/$defs/u64" },
            "version": { "$ref": "#/$defs/version_string" },
            "started_at": { "$ref": "#/$defs/timestamp" }
          }
        }
      }
    },
    "connection_error": {
      "description": "Sent instead of a welcome (refused handshake) or after a malformed frame; the sender closes the connection.",
      "type": "object",
      "required": ["type", "error"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "error" },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "request": {
      "type": "object",
      "required": ["type", "id", "method"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "request" },
        "id": { "type": "integer", "minimum": 1 },
        "method": { "enum": ["status", "activate", "capture", "capture.region", "capture.cancel", "pin.list", "pin.create", "pin.hide", "pin.show", "pin.close", "pin.reopen", "pin.set", "group.list", "group.switch", "hotkeys.reload", "settings.reload", "quit"] },
        "params": { "$ref": "#/$defs/params" }
      }
    },
    "params": {
      "description": "Parameters of every method (absent flags are false). capture: region and pin (required); capture.region and capture.cancel: dry_run only; pin.create: source (region with region, or clipboard with an optional at); pin.hide, pin.show, pin.close and pin.set: id, group or all; pin.show: on_screen; pin.set: at (one pin), zoom, opacity, rotation, mirrored, rotate, flip, thumbnail, click_through, move_to_group (Step 54); group.switch: group; quit: force.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": { "type": "boolean" },
        "region": { "$ref": "#/$defs/rect" },
        "pin": { "type": "boolean" },
        "id": { "$ref": "#/$defs/pin_id" },
        "all": { "type": "boolean" },
        "force": { "type": "boolean" },
        "reason": { "enum": ["start"] },
        "source": { "description": "pin.create: what the instance reads itself (Step 53).", "enum": ["region", "clipboard"] },
        "at": { "description": "pin.create with source clipboard: where the picture's top-left corner goes (default: the pointer); pin.set: where one pin's picture goes exactly (Step 54).", "$ref": "#/$defs/point" },
        "on_screen": { "description": "pin.show: also move pins no monitor shows into the nearest work area (NOEUL-FR-067).", "type": "boolean" },
        "group": { "description": "pin.hide, pin.show, pin.close and pin.set: every pin of this group; group.switch: the group to switch to (Step 54, NOEUL-FR-064).", "$ref": "#/$defs/group_name" },
        "zoom": { "description": "pin.set: the zoom (Step 54).", "$ref": "#/$defs/zoom" },
        "opacity": { "description": "pin.set: the opacity (Step 54, NOEUL-FR-062).", "$ref": "#/$defs/opacity" },
        "rotation": { "description": "pin.set: the rotation in degrees clockwise (absolute).", "enum": [0, 90, 180, 270] },
        "mirrored": { "description": "pin.set: mirrored left-right before the rotation (absolute).", "type": "boolean" },
        "rotate": { "description": "pin.set: a quarter turn right (cw) or left (ccw), after rotation and mirrored.", "enum": ["cw", "ccw"] },
        "flip": { "description": "pin.set: a flip as shown, after rotate.", "enum": ["horizontal", "vertical"] },
        "thumbnail": { "description": "pin.set: thumbnail mode on or off.", "type": "boolean" },
        "click_through": { "description": "pin.set: let mouse clicks pass through the pins (NOEUL-FR-063); the CLI's caller keeps the CLI as its way back.", "type": "boolean" },
        "move_to_group": { "description": "pin.set: move the pins to this group.", "$ref": "#/$defs/group_name" }
      }
    },
    "response_ok": {
      "type": "object",
      "required": ["type", "id", "result"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "response" },
        "id": { "type": "integer", "minimum": 1 },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/status_result" },
            { "$ref": "#/$defs/activate_result" },
            { "$ref": "#/$defs/capture_result" },
            { "$ref": "#/$defs/capture_region_result" },
            { "$ref": "#/$defs/capture_cancel_result" },
            { "$ref": "#/$defs/pin_list_result" },
            { "$ref": "#/$defs/pin_create_result" },
            { "$ref": "#/$defs/pin_hide_result" },
            { "$ref": "#/$defs/pin_show_result" },
            { "$ref": "#/$defs/pin_close_result" },
            { "$ref": "#/$defs/pin_reopen_result" },
            { "$ref": "#/$defs/pin_set_result" },
            { "$ref": "#/$defs/group_list_result" },
            { "$ref": "#/$defs/group_switch_result" },
            { "$ref": "#/$defs/reload_result" },
            { "$ref": "#/$defs/settings_reload_result" },
            { "$ref": "#/$defs/quit_result" }
          ]
        }
      }
    },
    "response_err": {
      "type": "object",
      "required": ["type", "id", "error"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "response" },
        "id": { "type": "integer", "minimum": 0 },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "desktop": {
      "type": "object",
      "required": ["state", "virtual_rect", "monitors"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["available", "locked", "disconnected", "non_interactive", "no_display", "unsupported_platform"] },
        "virtual_rect": { "oneOf": [{ "$ref": "#/$defs/rect" }, { "type": "null" }] },
        "monitors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rect", "primary", "dpi", "work"],
            "additionalProperties": false,
            "properties": {
              "rect": { "$ref": "#/$defs/rect" },
              "primary": { "type": "boolean" },
              "dpi": { "description": "Effective DPI (96 = 100 %); every rectangle is in device pixels (Step 50).", "type": "integer", "minimum": 1 },
              "work": { "description": "The work area: the monitor without the taskbar and docked bars; pins are placed inside it (Step 53).", "$ref": "#/$defs/rect" }
            }
          }
        }
      }
    },
    "hotkeys_state": {
      "description": "Global shortcut state of the running instance (or, offline, from the files). Conflicts are hotkeys-cli-v1 conflict objects.",
      "type": "object",
      "required": ["enabled", "config", "problem", "registrations"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "off_reason": { "oneOf": [{ "enum": ["--no-hotkeys", "KIM_NO_HOTKEYS", "safe_mode", "disabled"] }, { "type": "null" }] },
        "config": {
          "type": "object",
          "required": ["path", "state"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "state": { "enum": ["default", "user", "invalid", "newer_version"] }
          }
        },
        "problem": { "type": ["string", "null"] },
        "registrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action", "keys", "status", "message"],
            "additionalProperties": false,
            "properties": {
              "action": { "$ref": "#/$defs/action_id" },
              "keys": { "type": "string", "minLength": 1 },
              "status": { "enum": ["registered", "taken", "unsupported", "failed"] },
              "message": { "type": ["string", "null"] }
            }
          }
        },
        "conflicts": { "type": "array", "items": { "type": "object" } },
        "planned": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action", "default", "step"],
            "additionalProperties": false,
            "properties": {
              "action": { "$ref": "#/$defs/action_id" },
              "default": { "type": "string" },
              "step": { "type": "integer", "minimum": 50 }
            }
          }
        }
      }
    },
    "settings_state": {
      "type": "object",
      "required": ["path", "state", "tray_icon", "keyboard_help", "quick_save_folder", "detection", "magnifier", "pins", "gestures", "problems"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "state": { "enum": ["default", "user", "invalid", "newer_version"] },
        "tray_icon": { "type": "boolean" },
        "keyboard_help": { "description": "`[capture] keyboard_help`: when the capture overlay shows its keyboard help (Step 50).", "enum": ["first-run", "always", "never"] },
        "quick_save_folder": { "description": "`[capture] quick_save_folder` (Step 51); null: the Pictures folder + Noeul.", "type": ["string", "null"] },
        "detection": { "description": "`[capture] detection` (Step 52, NOEUL-FR-040): what the overlay detects under the pointer when it opens.", "enum": ["window", "element", "off"] },
        "magnifier": { "description": "`[capture] magnifier` (Step 52, NOEUL-FR-041): whether the overlay shows the magnifier when it opens.", "enum": ["on", "off"] },
        "pins": {
          "description": "`[pins]` (Step 54, UX spec §10): the outline and the shadow around every pin.",
          "type": "object",
          "required": ["border", "shadow"],
          "additionalProperties": false,
          "properties": {
            "border": { "enum": ["on", "off"] },
            "shadow": { "enum": ["on", "off"] }
          }
        },
        "gestures": {
          "description": "`[gestures]` (Step 51, NOEUL-FR-024): what a double-click and a middle-click inside a confirmed selection do, and the preset's name.",
          "type": "object",
          "required": ["double_click", "middle_click", "preset"],
          "additionalProperties": false,
          "properties": {
            "double_click": { "enum": ["pin", "copy", "save", "none"] },
            "middle_click": { "enum": ["pin", "copy", "none"] },
            "preset": { "enum": ["noeul", "snipaste"] }
          }
        },
        "problems": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status_result": {
      "description": "`status`. Also the `data` of `noeul status --json` while Noeul runs.",
      "type": "object",
      "required": ["running", "instance", "desktop", "capture_backend", "pins", "captures", "memory", "hotkeys", "tray", "settings", "last_action"],
      "additionalProperties": false,
      "properties": {
        "running": { "const": true },
        "instance": {
          "type": "object",
          "required": ["pid", "version", "started_at", "uptime_s", "endpoint", "session"],
          "additionalProperties": false,
          "properties": {
            "pid": { "$ref": "#/$defs/u64" },
            "version": { "$ref": "#/$defs/version_string" },
            "started_at": { "$ref": "#/$defs/timestamp" },
            "uptime_s": { "$ref": "#/$defs/u64" },
            "endpoint": { "type": "string", "pattern": "^\\\\\\\\\\.\\\\pipe\\\\[^\\\\/]{1,200}$" },
            "session": { "$ref": "#/$defs/u64" }
          }
        },
        "desktop": { "$ref": "#/$defs/desktop" },
        "capture_backend": { "description": "`synthetic` only in a debug build with the test hook NOEUL_DEV_SYNTHETIC_DESKTOP (ADR 0026).", "enum": ["gdi", "unsupported", "synthetic"] },
        "pins": {
          "type": "object",
          "required": ["open", "reopenable", "hidden", "off_screen", "click_through", "thumbnails", "group", "groups", "editor"],
          "additionalProperties": false,
          "properties": {
            "open": { "$ref": "#/$defs/u64" },
            "reopenable": { "oneOf": [{ "$ref": "#/$defs/pin_id" }, { "type": "null" }] },
            "hidden": { "description": "Open pins that are hidden (Step 53).", "$ref": "#/$defs/u64" },
            "off_screen": { "description": "Open pins no monitor shows enough of to reach, e.g. after a monitor was removed (Step 53, NOEUL-FR-067).", "$ref": "#/$defs/u64" },
            "click_through": { "description": "Open pins that let mouse clicks pass through (Step 54, NOEUL-FR-063).", "$ref": "#/$defs/u64" },
            "thumbnails": { "description": "Open pins in thumbnail mode (Step 54).", "$ref": "#/$defs/u64" },
            "group": { "description": "The current group: new pins go to it (Step 54).", "$ref": "#/$defs/group_name" },
            "groups": { "description": "How many groups there are, the current one included.", "type": "integer", "minimum": 1 },
            "editor": { "description": "The annotation editor of a pin (`pin.annotate`, Step 56), while one is open.", "oneOf": [{ "$ref": "#/$defs/overlay_state" }, { "type": "null" }] }
          }
        },
        "captures": {
          "type": "object",
          "required": ["started", "pinned", "copied", "saved", "cancelled", "open", "ignored", "history", "overlay", "first_frame"],
          "additionalProperties": false,
          "properties": {
            "started": { "$ref": "#/$defs/u64" },
            "pinned": { "$ref": "#/$defs/u64" },
            "copied": { "description": "Captures that ended with Copy (Step 51).", "$ref": "#/$defs/u64" },
            "saved": { "description": "Captures that ended with Save or quick save (Step 51).", "$ref": "#/$defs/u64" },
            "cancelled": { "$ref": "#/$defs/u64" },
            "open": { "type": "boolean" },
            "ignored": { "description": "Capture requests that found an overlay open and did nothing (NOEUL-FR-013).", "$ref": "#/$defs/u64" },
            "history": { "description": "Rectangles of earlier successful captures kept in memory for `history.previous`/`history.next` (Step 52, NOEUL-FR-050; at most 20, never on disk).", "type": "integer", "minimum": 0, "maximum": 20 },
            "overlay": { "oneOf": [{ "$ref": "#/$defs/overlay_state" }, { "type": "null" }] },
            "first_frame": { "$ref": "#/$defs/first_frame" }
          }
        },
        "memory": {
          "description": "Image buffers the instance holds (frames and bytes), a local metric (ADR 0012).",
          "type": "object",
          "required": ["frames", "bytes", "peak_bytes"],
          "additionalProperties": false,
          "properties": {
            "frames": { "$ref": "#/$defs/u64" },
            "bytes": { "$ref": "#/$defs/u64" },
            "peak_bytes": { "$ref": "#/$defs/u64" }
          }
        },
        "hotkeys": { "$ref": "#/$defs/hotkeys_state" },
        "tray": {
          "type": "object",
          "required": ["enabled", "shown"],
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" }, "shown": { "type": "boolean" } }
        },
        "settings": { "$ref": "#/$defs/settings_state" },
        "last_action": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["action", "result"],
              "additionalProperties": false,
              "properties": { "action": { "type": "string" }, "result": { "type": "string" } }
            }
          ]
        }
      }
    },
    "offline_status": {
      "description": "The `data` of `noeul status --json` when no instance runs (not an IPC message).",
      "type": "object",
      "required": ["running", "desktop", "capture_backend", "hotkeys", "settings"],
      "additionalProperties": false,
      "properties": {
        "running": { "const": false },
        "desktop": { "$ref": "#/$defs/desktop" },
        "capture_backend": { "enum": ["gdi", "unsupported"] },
        "hotkeys": { "$ref": "#/$defs/hotkeys_state" },
        "settings": { "$ref": "#/$defs/settings_state" }
      }
    },
    "activate_result": {
      "type": "object",
      "required": ["activated", "pid", "settings_window", "clickable"],
      "additionalProperties": false,
      "properties": {
        "activated": { "const": true },
        "pid": { "$ref": "#/$defs/u64" },
        "settings_window": { "enum": ["planned", "opened"] },
        "clickable": { "description": "Pins that let clicks through and were made clickable again by this second start (Step 54, NOEUL-FR-063).", "type": "array", "items": { "$ref": "#/$defs/pin_id" } }
      }
    },
    "pin_ref": {
      "type": "object",
      "required": ["id", "rect", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/pin_id" },
        "rect": { "description": "The picture on screen: position and shown size (at its zoom, turned, or the thumbnail); the window adds the outline and shadow around it.", "$ref": "#/$defs/rect" },
        "source": { "enum": ["capture", "clipboard"] },
        "zoom": { "$ref": "#/$defs/zoom" }
      }
    },
    "capture_result": {
      "type": "object",
      "required": ["dry_run", "region", "pin", "desktop"],
      "additionalProperties": false,
      "properties": {
        "dry_run": { "type": "boolean" },
        "region": { "$ref": "#/$defs/rect" },
        "pin": { "oneOf": [{ "$ref": "#/$defs/pin_ref" }, { "type": "null" }] },
        "desktop": { "const": "available" }
      }
    },
    "annotation_state": {
      "description": "The overlay's annotations (Step 56, NOEUL-FR-080/081; the privacy tools mosaic, blur, eraser and solid redaction since Step 57, NOEUL-FR-082): the tool, counts, IDs and style only, never the text of a label, a point, a pixel or what a redaction covers (NOEUL-SEC-008).",
      "type": "object",
      "required": ["tool", "objects", "kinds", "selected", "undo", "redo", "editing_text", "composing", "color", "width"],
      "additionalProperties": false,
      "properties": {
        "tool": { "oneOf": [{ "type": "null" }, { "enum": ["rectangle", "ellipse", "line", "arrow", "pen", "marker", "text", "mosaic", "blur", "eraser", "redact"] }] },
        "objects": { "$ref": "#/$defs/u64" },
        "kinds": {
          "description": "How many objects of each kind.",
          "type": "object",
          "required": ["rectangle", "ellipse", "line", "arrow", "pen", "marker", "text", "mosaic", "blur", "eraser", "redact"],
          "additionalProperties": false,
          "properties": {
            "rectangle": { "$ref": "#/$defs/u64" },
            "ellipse": { "$ref": "#/$defs/u64" },
            "line": { "$ref": "#/$defs/u64" },
            "arrow": { "$ref": "#/$defs/u64" },
            "pen": { "$ref": "#/$defs/u64" },
            "marker": { "$ref": "#/$defs/u64" },
            "text": { "$ref": "#/$defs/u64" },
            "mosaic": { "$ref": "#/$defs/u64" },
            "blur": { "$ref": "#/$defs/u64" },
            "eraser": { "$ref": "#/$defs/u64" },
            "redact": { "description": "Solid redactions (irreversible in every output).", "$ref": "#/$defs/u64" }
          }
        },
        "selected": { "description": "The selected object's ID.", "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "undo": { "description": "Undo steps available.", "$ref": "#/$defs/u64" },
        "redo": { "description": "Redo steps available.", "$ref": "#/$defs/u64" },
        "editing_text": { "description": "A label is being edited (every other shortcut is suspended).", "type": "boolean" },
        "composing": { "description": "An input-method composition is shown in the label.", "type": "boolean" },
        "color": { "description": "The colour new objects of the current tool get (the redaction tool keeps its own, black by default).", "enum": ["red", "orange", "yellow", "green", "blue", "purple", "black", "white"] },
        "width": { "description": "The line width in logical pixels.", "enum": [1, 2, 3, 4, 6, 8, 12] }
      }
    },
    "overlay_state": {
      "description": "The open capture overlay (Step 50, ADR 0026): geometry and state only, never pixels, colours, window titles or element names (NOEUL-SEC-007, NOEUL-SEC-008).",
      "type": "object",
      "required": ["session", "mode", "pin", "phase", "selection", "picture", "monitors", "buffer_bytes", "help", "focus", "pointer", "detection", "magnifier", "history", "annotation"],
      "additionalProperties": false,
      "properties": {
        "session": { "description": "The capture session; 0 while a pin is edited.", "$ref": "#/$defs/u64" },
        "mode": { "description": "`capture`: the region capture overlay; `pin_edit`: a pin's annotation editor (Step 56).", "enum": ["capture", "pin_edit"] },
        "pin": { "description": "The pin being edited (`pin_edit`), else null.", "oneOf": [{ "$ref": "#/$defs/pin_id" }, { "type": "null" }] },
        "phase": { "description": "`marking`: the first corner was set with `selection.mark` (Step 52). `annotating`: a drawing tool is active, a label is edited or a stroke is drawn (Step 56).", "enum": ["hover", "pressed", "dragging", "selected", "moving", "resizing", "marking", "annotating"] },
        "selection": { "oneOf": [{ "$ref": "#/$defs/rect" }, { "type": "null" }] },
        "picture": { "$ref": "#/$defs/rect" },
        "monitors": { "$ref": "#/$defs/u64" },
        "buffer_bytes": { "$ref": "#/$defs/u64" },
        "help": { "type": "boolean" },
        "focus": { "description": "What has the keyboard focus (Step 51): the canvas or a toolbar button (the annotation buttons since Step 56, the privacy tools since Step 57).", "enum": ["canvas", "pin", "copy", "save", "rectangle", "ellipse", "line", "arrow", "pen", "marker", "text", "mosaic", "blur", "eraser", "redact", "color", "width", "undo", "redo", "done", "cancel"] },
        "pointer": { "description": "Where the overlay's pointer is (Step 52; moved by the mouse or the pointer keys).", "$ref": "#/$defs/point" },
        "detection": {
          "description": "Hover detection (Step 52, NOEUL-FR-040, ADR 0035): rectangles only.",
          "type": "object",
          "required": ["mode", "windows", "target", "protected", "fallback", "suspended"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["window", "element", "off"] },
            "windows": { "description": "Windows detection offers in this capture; null: no window list (detection off since the overlay opened, or the list could not be read).", "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
            "target": {
              "description": "What a click or `selection.mark` would select now; null when nothing is detected.",
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["kind", "rect"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "enum": ["window", "element"] },
                    "rect": { "$ref": "#/$defs/rect" }
                  }
                }
              ]
            },
            "protected": { "description": "The pointer is over a window protected from capture (WDA_MONITOR): Windows captures it black; it is never highlighted (NOEUL-SEC-004).", "type": "boolean" },
            "fallback": { "description": "Why the last element lookup used the window rectangle.", "oneOf": [{ "type": "null" }, { "enum": ["denied", "timeout", "unavailable", "invalid_rect"] }] },
            "suspended": { "description": "The keyboard moved the pointer last: detection and snapping pause until the mouse moves.", "type": "boolean" }
          }
        },
        "magnifier": {
          "description": "The magnifier (Step 52, NOEUL-FR-041); its colour readout is drawn, never reported.",
          "type": "object",
          "required": ["enabled", "shown"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "shown": { "type": "boolean" }
          }
        },
        "annotation": { "$ref": "#/$defs/annotation_state" },
        "history": {
          "description": "`history.previous`/`history.next` (Step 52): rectangles kept for this overlay and the one shown (0 = oldest).",
          "type": "object",
          "required": ["count", "position"],
          "additionalProperties": false,
          "properties": {
            "count": { "type": "integer", "minimum": 0, "maximum": 20 },
            "position": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 19 }] }
          }
        }
      }
    },
    "first_frame": {
      "description": "First-frame latency of the overlay (request to overlay painted, NOEUL-NFR-003), a local metric (ADR 0012). Percentiles cover the last 100 captures.",
      "type": "object",
      "required": ["count", "last", "p50_us", "p95_us"],
      "additionalProperties": false,
      "properties": {
        "count": { "$ref": "#/$defs/u64" },
        "last": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["total_us", "capture_us", "render_us", "width", "height"],
              "additionalProperties": false,
              "properties": {
                "total_us": { "$ref": "#/$defs/u64" },
                "capture_us": { "$ref": "#/$defs/u64" },
                "render_us": { "$ref": "#/$defs/u64" },
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "p50_us": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "p95_us": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] }
      }
    },
    "capture_region_result": {
      "description": "`capture.region`: open the selection overlay, as F1 does. `opened` is false for a dry run and while an overlay is already open (`reason: already_open`).",
      "type": "object",
      "required": ["dry_run", "opened", "reason", "session", "picture", "monitors", "first_frame_us"],
      "additionalProperties": false,
      "properties": {
        "dry_run": { "type": "boolean" },
        "opened": { "type": "boolean" },
        "reason": { "oneOf": [{ "const": "already_open" }, { "type": "null" }] },
        "session": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "picture": { "oneOf": [{ "$ref": "#/$defs/rect" }, { "type": "null" }] },
        "monitors": { "$ref": "#/$defs/u64" },
        "first_frame_us": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] }
      }
    },
    "capture_cancel_result": {
      "description": "`capture.cancel`: close an open overlay without pinning, copying or saving anything.",
      "type": "object",
      "required": ["dry_run", "cancelled", "session"],
      "additionalProperties": false,
      "properties": {
        "dry_run": { "type": "boolean" },
        "cancelled": { "type": "boolean" },
        "session": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] }
      }
    },
    "pin_list_result": {
      "type": "object",
      "required": ["pins", "reopenable", "group"],
      "additionalProperties": false,
      "properties": {
        "pins": {
          "type": "array",
          "items": { "$ref": "#/$defs/pin_entry" }
        },
        "reopenable": { "oneOf": [{ "$ref": "#/$defs/pin_id" }, { "type": "null" }] },
        "group": { "description": "The current group (Step 54).", "$ref": "#/$defs/group_name" }
      }
    },
    "pin_entry": {
      "type": "object",
      "required": ["id", "rect", "image", "zoom", "visible", "on_screen", "source", "created_at", "annotations", "editing", "orientation", "opacity", "thumbnail", "click_through", "group", "animation"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/pin_id" },
        "rect": { "description": "The picture on screen: position and shown size (at its zoom, turned, or the thumbnail); the window adds the outline and shadow around it.", "$ref": "#/$defs/rect" },
        "image": {
          "description": "The picture's size in pixels (100 %, as captured, before any rotation).",
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 32767 },
            "height": { "type": "integer", "minimum": 1, "maximum": 32767 }
          }
        },
        "zoom": { "$ref": "#/$defs/zoom" },
        "visible": { "description": "False while the pin is hidden (Step 53).", "type": "boolean" },
        "on_screen": { "description": "Whether a monitor shows enough of the pin to reach it; null while the desktop is not available (Step 53).", "type": ["boolean", "null"] },
        "source": { "enum": ["capture", "clipboard"] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "annotations": { "description": "Annotations the pin carries as editable objects (Step 56).", "$ref": "#/$defs/u64" },
        "editing": { "description": "Its annotations are being edited (its window is hidden meanwhile).", "type": "boolean" },
        "orientation": { "$ref": "#/$defs/orientation" },
        "opacity": { "$ref": "#/$defs/opacity" },
        "thumbnail": { "description": "Thumbnail mode: `rect` is the thumbnail, `zoom` waits for when it ends (Step 54).", "type": "boolean" },
        "click_through": { "description": "Mouse clicks pass through it (Step 54, NOEUL-FR-063).", "type": "boolean" },
        "group": { "$ref": "#/$defs/group_name" },
        "animation": {
          "description": "Made from an animated GIF, of which it shows only the first frame (NOEUL-FR-068: never flattened silently); null otherwise.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["frames", "shown"],
              "additionalProperties": false,
              "properties": {
                "frames": { "type": "integer", "minimum": 2 },
                "shown": { "const": "first_frame" }
              }
            }
          ]
        }
      }
    },
    "pin_set_result": {
      "description": "`pin.set` (Step 54): the pins named, the ones that changed (none for a dry run) and how they are now.",
      "type": "object",
      "required": ["dry_run", "targets", "changed", "pins"],
      "additionalProperties": false,
      "properties": {
        "dry_run": { "type": "boolean" },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/pin_id" } },
        "changed": { "type": "array", "items": { "$ref": "#/$defs/pin_id" } },
        "pins": { "type": "array", "items": { "$ref": "#/$defs/pin_entry" } }
      }
    },
    "group_list_result": {
      "description": "`group.list` (Step 54): every group with open pins and the current one.",
      "type": "object",
      "required": ["current", "groups"],
      "additionalProperties": false,
      "properties": {
        "current": { "$ref": "#/$defs/group_name" },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "pins", "hidden"],
            "additionalProperties": false,
            "properties": {
              "name": { "$ref": "#/$defs/group_name" },
              "pins": { "$ref": "#/$defs/u64" },
              "hidden": { "$ref": "#/$defs/u64" }
            }
          }
        }
      }
    },
    "group_switch_result": {
      "description": "`group.switch` (Step 54): the pins shown and hidden by the switch (or that would be, in a dry run).",
      "type": "object",
      "required": ["dry_run", "group", "shown", "hidden"],
      "additionalProperties": false,
      "properties": {
        "dry_run": { "type": "boolean" },
        "group": { "$ref": "#/$defs/group_name" },
        "shown": { "type": "array", "items": { "$ref": "#/$defs/pin_id" } },
        "hidden": { "type": "array", "items": { "$ref": "#/$defs/pin_id" } }
      }
    },
    "pin_create_result": {
      "description": "`pin.create` (Step 53): the instance captured the region or read the clipboard itself; `pin` is null for a dry run, which captures and reads nothing.",
      "type": "object",
      "required": ["dry_run", "source", "pin"],
      "additionalProperties": false,
      "properties": {
        "dry_run": { "type": "boolean" },
        "source": { "enum": ["region", "clipboard"] },
        "pin": { "oneOf": [{ "$ref": "#/$defs/pin_ref" }, { "type": "null" }] }
      }
    },
    "pin_hide_result": {
      "description": "`pin.hide` (Step 53): the pins that were (or, in a dry run, would be) hidden; pins hidden already are not listed.",
      "type": "object",
      "required": ["dry_run", "hidden"],
      "additionalProperties": false,
      "properties": {
        "dry_run": { "type": "boolean" },
        "hidden": { "type": "array", "items": { "$ref": "#/$defs/pin_id" } }
      }
    },
    "pin_show_result": {
      "description": "`pin.show` (Step 53): the pins that were shown again, and (with on_screen) moved into a work area.",
      "type": "object",
      "required": ["dry_run", "shown", "moved"],
      "additionalProperties": false,
      "properties": {
        "dry_run": { "type": "boolean" },
        "shown": { "type": "array", "items": { "$ref": "#/$defs/pin_id" } },
        "moved": { "type": "array", "items": { "$ref": "#/$defs/pin_id" } }
      }
    },
    "pin_close_result": {
      "type": "object",
      "required": ["dry_run", "closed", "reopenable"],
      "additionalProperties": false,
      "properties": {
        "dry_run": { "type": "boolean" },
        "closed": { "type": "array", "items": { "$ref": "#/$defs/pin_id" } },
        "reopenable": { "oneOf": [{ "$ref": "#/$defs/pin_id" }, { "type": "null" }] }
      }
    },
    "pin_reopen_result": {
      "type": "object",
      "required": ["dry_run", "pin"],
      "additionalProperties": false,
      "properties": {
        "dry_run": { "type": "boolean" },
        "pin": { "$ref": "#/$defs/pin_id" }
      }
    },
    "reload_result": {
      "type": "object",
      "required": ["reloaded", "problem", "hotkeys"],
      "additionalProperties": false,
      "properties": {
        "reloaded": { "type": "boolean" },
        "problem": { "type": ["string", "null"] },
        "hotkeys": { "$ref": "#/$defs/hotkeys_state" }
      }
    },
    "settings_reload_result": {
      "description": "`settings.reload` (Step 51): config.toml read again; the gestures, keyboard help and quick-save folder apply from the next capture.",
      "type": "object",
      "required": ["reloaded", "settings"],
      "additionalProperties": false,
      "properties": {
        "reloaded": { "type": "boolean" },
        "settings": { "$ref": "#/$defs/settings_state" }
      }
    },
    "quit_result": {
      "type": "object",
      "required": ["dry_run", "quitting", "closed_pins"],
      "additionalProperties": false,
      "properties": {
        "dry_run": { "type": "boolean" },
        "quitting": { "type": "boolean" },
        "closed_pins": { "$ref": "#/$defs/u64" }
      }
    }
  }
}
